#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing files
/android/key.properties
*.jks
*.keystore
/android/app/*.jks
/android/app/*.keystore

# Release info (contains sensitive data)
RELEASE_INFO.md

# Firebase config files (sensitive)
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# Environment variables
.env
.env.local
.env.production

# Auth tokens and secrets
auth_token.txt
secrets.json

# Screen UI folder (local development only)
Screen_ui/
